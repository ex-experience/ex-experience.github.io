                let html = '';
                querySnapshot.forEach((doc) => {
                    const data = doc.data();
                    const dateStr = data.Timestamp ? new Date(data.Timestamp.toDate()).toLocaleDateString() : 'Recent';
                    html += `
                    <div class="history-card">
                        <div class="h-details">
                            <p class="h-msg">${data.Message}</p>
                            <span class="h-date">${dateStr}</span>
                        </div>
                        <span class="h-status">${data.Status}</span>
                    </div>`;
                });
                historyContainer.innerHTML = html;
            } catch (error) { historyContainer.innerHTML = `<p class="text-body" style="text-align:center;">${isAr ? 'خطأ في النظام.' : 'System Error.'}</p>`; }
        }

        async function submitFirebaseConsult(e) {
            e.preventDefault();
            const btn = document.getElementById('consultBtn');
            const isAr = document.body.classList.contains('lang-ar');
            const message = document.getElementById('consultText').value;
            btn.innerHTML = isAr ? 'جاري الإرسال...' : 'Transmitting...'; btn.disabled = true;
            try {
                await db.collection("Consultations").add({ Name: currentUser.Name, Email: currentUser.Email, Message: message, Status: "Pending", Timestamp: firebase.firestore.FieldValue.serverTimestamp() });
                fetch(GOOGLE_SCRIPT_URL, { method: 'POST', body: new URLSearchParams({ Token: SECURE_TOKEN, Type: 'Strategic Inquiry', Name: currentUser.Name, Email: currentUser.Email, Message: message }), mode: 'no-cors' });
                alert(isAr ? 'تم الإرسال بنجاح.' : 'Transmission Successful.');
                document.getElementById('consultText').value = '';
                switchService('history');
            } catch (error) { alert(isAr ? 'فشل الإرسال.' : 'Transmission Failed.'); }
            btn.innerHTML = isAr ? 'إرسال' : 'Transmit'; btn.disabled = false;
        }

        // NEXUS COMMAND
        async function queryDeepMatrix(text, isTerminal = false, loadingElement = null) {
            const url = `${GOOGLE_SCRIPT_URL}?Token=${SECURE_TOKEN}&Message=${encodeURIComponent(text)}&Name=${encodeURIComponent(currentUser.Name)}&Email=${encodeURIComponent(currentUser.Email)}`;
            try {
                const response = await fetch(url);
                const data = await response.json();
                if (loadingElement) loadingElement.remove();
                const finalOutput = data.reply || data.error;
                if(isTerminal) printNexus(`> ${finalOutput}`); else appendMsg(finalOutput, 'bot');
            } catch (error) {
                if (loadingElement) loadingElement.remove();
                if(isTerminal) printNexus(`> SIGNAL LOST.`); else appendMsg("SIGNAL LOST.", 'bot');
            }
        }

        const nexusOutput = document.getElementById('nexusOutput');
        const nexusInput = document.getElementById('nexusInput');
        function handleNexus(e) {
            if(e.key === 'Enter') {
                e.preventDefault();
                const cmd = nexusInput.value.trim();
                if(cmd === '') return;
                printNexus(`root@nexus:~# ${cmd}`);
                nexusInput.value = '';
                if(cmd.toLowerCase() === '/clear') nexusOutput.innerHTML = '';
                else queryDeepMatrix(cmd, true);
            }
        }
        function printNexus(text) { nexusOutput.innerHTML += `\n${text}`; nexusOutput.scrollTop = nexusOutput.scrollHeight; }

        // AI Chat UI
        const chatWindow = document.getElementById('aiWindow');
        const chatBody = document.getElementById('chatBody');
        const aiInput = document.getElementById('aiInput');
        
        function toggleChat() {
            chatWindow.classList.toggle('open');
            if(chatWindow.classList.contains('open') && chatBody.innerHTML === '') {
                const isAr = document.body.classList.contains('lang-ar');
                appendMsg(isAr ? "مرحباً بك. أنا Ex Oracle للمساعدة." : "Hi. I am Ex Oracle, how can I assist you?", 'bot');
            }
        }

        function appendMsg(text, sender) {
            const wrapDiv = document.createElement('div');
            wrapDiv.className = `ai-msg-wrap ${sender}`;
            
            let safeText = text.replace(/</g, "&lt;").replace(/>/g, "&gt;");
            safeText = safeText.replace(/\*\*(.*?)\*\*/g, '<strong>$1</strong>');
            safeText = safeText.replace(/\*(.*?)\*/g, '<em>$1</em>');
            safeText = safeText.replace(/\n/g, '<br>');

            let innerHTML = `<div class="ai-msg ${sender}">${safeText}</div>`;
            
            if (sender === 'bot' && text !== '...' && !text.includes('Processing') && !text.includes('المعالجة')) {
                innerHTML += `
                <div class="msg-actions">
                    <button class="msg-btn" onclick="navigator.clipboard.writeText('${text.replace(/'/g, "\\'")}');" title="Copy">
                        <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect x="9" y="9" width="13" height="13" rx="2" ry="2"></rect><path d="M5 15H4a2 2 0 0 1-2-2V4a2 2 0 0 1 2-2h9a2 2 0 0 1 2 2v1"></path></svg>
                    </button>
                    <button class="msg-btn" title="Good Response">
                        <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M20 6L9 17l-5-5"></path></svg>
                    </button>
                </div>`;
            }
            
            wrapDiv.innerHTML = innerHTML;
            chatBody.appendChild(wrapDiv);
            chatBody.scrollTop = chatBody.scrollHeight;
            return wrapDiv;
        }

        function handleChatEnter(e) { if(e.key === 'Enter') { e.preventDefault(); sendChatMessage(); } }
        
        function sendChatMessage() {
            const text = aiInput.value.trim();
            if(!text) return;
            appendMsg(text, 'user');
            aiInput.value = '';
            const isAr = document.body.classList.contains('lang-ar');
            const loadingElement = appendMsg(isAr ? "..." : "...", 'bot');
            queryDeepMatrix(text, false, loadingElement);
        }

        // 3D Blueprint Integration Script
        function init3DBlueprint() {
            const container = document.getElementById('canvas-container');
            if(!container) return;
            
            // Remove previous canvas if exists (prevents duplicate rendering)
            const oldLoader = document.getElementById('blueprint-loader');
            if(oldLoader) {
                oldLoader.style.opacity = '0';
                setTimeout(() => oldLoader.style.display = 'none', 1000);
            }

            const scene = new THREE.Scene();
            scene.fog = new THREE.FogExp2(0x020202, 0.0015);

            const camera = new THREE.PerspectiveCamera(45, window.innerWidth / window.innerHeight, 1, 4000);
            camera.position.set(0, 300, 800);

            const renderer = new THREE.WebGLRenderer({ antialias: true, alpha: true });
            
            // Make sure the renderer size fits the section
            const sectionHeight = document.getElementById('blueprint-section').offsetHeight;
            renderer.setSize(window.innerWidth, sectionHeight);
            renderer.setPixelRatio(window.devicePixelRatio);
            container.appendChild(renderer.domElement);

            const controls = new THREE.OrbitControls(camera, renderer.domElement);
            controls.enableDamping = true;
            controls.dampingFactor = 0.05;
            controls.autoRotate = true;
            controls.autoRotateSpeed = 0.5;
            controls.enableZoom = false; // Disable zooming so it doesn't mess with page scroll
            controls.enablePan = false;

            const gridHelper = new THREE.GridHelper(2000, 100, 0x0A84FF, 0x0A84FF);
            gridHelper.material.opacity = 0.15;
            gridHelper.material.transparent = true;
            scene.add(gridHelper);

            const canvas = document.createElement('canvas');
            canvas.width = 4096;
            canvas.height = 2048;
            const ctx = canvas.getContext('2d');

            ctx.fillStyle = 'rgba(2, 2, 2, 0.8)';
            ctx.fillRect(0, 0, canvas.width, canvas.height);

            ctx.strokeStyle = 'rgba(10, 132, 255, 0.4)';
            ctx.lineWidth = 2;
            
            ctx.beginPath();
            ctx.moveTo(0, canvas.height/2); ctx.lineTo(canvas.width, canvas.height/2);
            ctx.moveTo(canvas.width/2, 0); ctx.lineTo(canvas.width/2, canvas.height);
            ctx.stroke();

            ctx.beginPath(); ctx.arc(canvas.width/2, canvas.height/2, 400, 0, Math.PI*2); ctx.stroke();
            ctx.beginPath(); ctx.arc(canvas.width/2, canvas.height/2, 420, 0, Math.PI*2); ctx.stroke();
            ctx.beginPath(); ctx.arc(canvas.width/2, canvas.height/2, 600, 0, Math.PI*2); ctx.stroke();

            ctx.fillStyle = '#0A84FF';
            ctx.font = '30px "Space Mono"';
            ctx.fillText('W: 1991.00 mm', canvas.width/2 + 620, canvas.height/2);
            ctx.fillText('H: 33.00 mm', canvas.width/2, canvas.height/2 - 440);
            ctx.fillText('RAD: 400.00 EX', canvas.width/2 + 200, canvas.height/2 - 200);
            ctx.fillText('RAD: 600.00 EX', canvas.width/2 + 400, canvas.height/2 - 400);

            ctx.beginPath();
            ctx.moveTo(canvas.width/2 - 800, canvas.height/2 - 800);
            ctx.lineTo(canvas.width/2 + 800, canvas.height/2 + 800);
            ctx.stroke();

            ctx.textAlign = 'center';
            ctx.textBaseline = 'middle';
            ctx.font = '200px "Noto Sans JP", "Inter", sans-serif';
            
            ctx.fillStyle = 'rgba(0, 229, 255, 0.7)';
            ctx.fillText('フサム | experience™', canvas.width/2 + 8, canvas.height/2 - 50);
            ctx.fillStyle = 'rgba(255, 0, 60, 0.7)';
            ctx.fillText('フサム | experience™', canvas.width/2 - 8, canvas.height/2 - 50);
            ctx.fillStyle = '#FFFFFF';
            ctx.fillText('フサム | experience™', canvas.width/2, canvas.height/2 - 50);

            ctx.font = '60px "Inter"';
            ctx.letterSpacing = "10px";
            ctx.fillStyle = '#FFFFFF';
            ctx.fillText('Engineering human experiences', canvas.width/2, canvas.height/2 + 150);

            ctx.font = '25px "Space Mono"';
            ctx.fillStyle = 'rgba(249, 249, 249, 0.5)';
            const patternText = "HX-5TM x 33GUIDETM x iNSTUDIOTM x フサムフサムフサムフサムフサムフサムフサムフサムフiNSTUDIOTM x DROPzeroTM x iNSIDETM x PRO | LABTM x C©Ncept house • 1991";
            
            for(let i=0; i<3; i++) {
                ctx.fillText(patternText, canvas.width/2, 100 + (i*40));
                ctx.fillText(patternText, canvas.width/2, canvas.height - 100 - (i*40));
            }

            const texture = new THREE.CanvasTexture(canvas);
            texture.anisotropy = renderer.capabilities.getMaxAnisotropy();

            const geometry = new THREE.PlaneGeometry(1600, 800);
            const material = new THREE.MeshBasicMaterial({ 
                map: texture, 
                transparent: true, 
                opacity: 0.9,
                side: THREE.DoubleSide,
                blending: THREE.AdditiveBlending
            });
            
            const hologramPlane = new THREE.Mesh(geometry, material);
            hologramPlane.rotation.x = -Math.PI / 2;
            scene.add(hologramPlane);

            const boxGeo = new THREE.BoxGeometry(1600, 200, 800);
            const edges = new THREE.EdgesGeometry(boxGeo);
            const lineMat = new THREE.LineBasicMaterial({ color: 0x0A84FF, transparent: true, opacity: 0.3 });
            const wireframeBox = new THREE.LineSegments(edges, lineMat);
            wireframeBox.position.y = 100;
            scene.add(wireframeBox);

            const verticalPlaneGeo = new THREE.PlaneGeometry(800, 400);
            const verticalMat = new THREE.MeshBasicMaterial({ 
                color: 0x00e5ff, 
                wireframe: true, 
                transparent: true, 
                opacity: 0.1 
            });
            const verticalPlane1 = new THREE.Mesh(verticalPlaneGeo, verticalMat);
            verticalPlane1.position.y = 200;
            scene.add(verticalPlane1);

            const verticalPlane2 = new Mesh(verticalPlaneGeo, verticalMat);
            verticalPlane2.rotation.y = Math.PI / 2;
            verticalPlane2.position.y = 200;
            scene.add(verticalPlane2);

            const particlesGeo = new THREE.BufferGeometry();
            const particlesCount = 2000;
            const posArray = new Float32Array(particlesCount * 3);

            for(let i = 0; i < particlesCount * 3; i++) {
                posArray[i] = (Math.random() - 0.5) * 2000;
            }

            particlesGeo.setAttribute('position', new THREE.BufferAttribute(posArray, 3));
            const particlesMat = new THREE.PointsMaterial({
                size: 2,
                color: 0x0A84FF,
                transparent: true,
                opacity: 0.4,
                blending: THREE.AdditiveBlending
            });

            const particlesMesh = new THREE.Points(particlesGeo, particlesMat);
            scene.add(particlesMesh);

            const clock = new THREE.Clock();

            // Optimization: Only animate when visible
            let isVisible = true;
            const observer = new IntersectionObserver((entries) => {
                entries.forEach(entry => {
                    isVisible = entry.isIntersecting;
                });
            });
            observer.observe(document.getElementById('blueprint-section'));

            function animate() {
                requestAnimationFrame(animate);
                
                if(!isVisible) return; // Don't waste GPU when off-screen

                const elapsedTime = clock.getElapsedTime();

                particlesMesh.rotation.y = elapsedTime * 0.02;
                particlesMesh.position.y = Math.sin(elapsedTime * 0.5) * 10;

                wireframeBox.material.opacity = 0.2 + Math.sin(elapsedTime * 2) * 0.1;
                verticalPlane1.material.opacity = 0.05 + Math.sin(elapsedTime * 3) * 0.05;

                controls.update();
                renderer.render(scene, camera);
            }

            animate();

            window.addEventListener('resize', () => {
                const w = window.innerWidth;
                const h = document.getElementById('blueprint-section').offsetHeight;
                camera.aspect = w / h;
                camera.updateProjectionMatrix();
                renderer.setSize(w, h);
            });
        }
    </script>
