        /* COMPACT NEXUS COMMAND */
        .nexus-window { background: rgba(15, 20, 25, 0.95); backdrop-filter: blur(10px); border: 1px solid rgba(255, 255, 255, 0.1); border-radius: 12px; padding: 20px; font-family: 'Space Mono', monospace; color: #fff; height: 260px; display: flex; flex-direction: column; box-shadow: inset 0 0 15px rgba(255,255,255,0.02);}
